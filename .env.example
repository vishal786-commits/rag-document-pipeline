# Copy to .env and fill in.

OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# Optional -- these are the defaults.
PINECONE_NAMESPACE=knowledgebase
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Where the Streamlit frontend looks for the API.
API_URL=http://localhost:8000

# Windows: the console defaults to cp1252 and will crash on any non-ASCII
# output. Keep this set, or run `chcp 65001` first.
PYTHONUTF8=1
